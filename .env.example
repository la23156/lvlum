# Copy to .env and fill in real values. Never commit .env.

# OpenAI — used by the extraction pipeline, embeddings, and the AI Assistant
OPENAI_API_KEY=sk-your-openai-key

# Server
JWT_SECRET=change-me-to-a-long-random-string
PORT=8000

# Auth (phone-OTP login)
ADMIN_PHONE=+15551234567
ALLOWED_PHONES=
OTP_TTL_SECONDS=300
JWT_TTL_HOURS=24
OTP_RATE_LIMIT_PER_PHONE_PER_15M=3

# Twilio SMS (leave blank and set DEV_AUTH_BYPASS=1 for local dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Local dev: skip real SMS; log in with DEV_CODE
DEV_AUTH_BYPASS=1
DEV_CODE=000000

# AI Assistant models
ASSIST_MODEL=gpt-5-mini
ASSIST_PARSE_MODEL=gpt-5-mini
ASSIST_WORKERS=6
ASSIST_BATCH=24
